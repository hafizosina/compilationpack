[sub_resource type="Resource" id="c_body"]
script = ExtResource("s_body")
radius = 22.0

[sub_resource type="Resource" id="c_sprite"]
script = ExtResource("s_sprite")
texture = ExtResource("tex_rabbit")
scale_factor = 0.32
tint = Color(0.93, 0.93, 0.9, 1)

[sub_resource type="Resource" id="c_movement"]
script = ExtResource("s_movement")
speed = 165.0

[sub_resource type="Resource" id="c_brain"]
script = ExtResource("s_brain")
radius = 320.0
pause_min = 0.5
pause_max = 3.0

[sub_resource type="Resource" id="c_sensor"]
script = ExtResource("s_sensor")
radius = 280.0

[sub_resource type="Resource" id="c_action"]
script = ExtResource("s_action")

[sub_resource type="Resource" id="c_hunger"]
script = ExtResource("s_hunger")
drain = 1.2
forage_below = 65.0
heal_above = 50.0
heal_rate = 5.0
eat_below = 70.0


[sub_resource type="Resource" id="c_health"]
script = ExtResource("s_health")


[sub_resource type="Resource" id="c_energy"]
script = ExtResource("s_energy")
start_min = 0.5
restore = 10.0

[sub_resource type="Resource" id="c_planner"]
script = ExtResource("s_planner")
actions = Array[ExtResource("s_action_def")]([ExtResource("a_eat_ground"), ExtResource("a_seek_food"), ExtResource("a_seek_bush"), ExtResource("a_harvest"), ExtResource("a_sleep")])
goals = Array[ExtResource("s_goal_def")]([ExtResource("g_satisfy_hunger"), ExtResource("g_rest")])

[resource]
script = ExtResource("def")
id = &"rabbit"
display_name = "Rabbit"
components = Array[ExtResource("base")]([SubResource("c_energy"), SubResource("c_health"), SubResource("c_hunger"), SubResource("c_body"), SubResource("c_sprite"), SubResource("c_movement"), SubResource("c_brain"), SubResource("c_sensor"), SubResource("c_action"), SubResource("c_planner")])
