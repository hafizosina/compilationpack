[resource]
script = ExtResource("def")
id = &"fireball"
display_name = "Fireball"
components = Array[ExtResource("base")]([SubResource("c_move"), SubResource("c_action"), SubResource("c_projectile"), SubResource("c_lifetime"), SubResource("c_remains"), SubResource("c_sprite")])
