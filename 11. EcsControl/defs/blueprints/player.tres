[gd_resource type="Resource" script_class="EcsEntityDef" format=3]

[ext_resource type="Script" uid="uid://cc5jtxa1fcpu8" path="res://9. EcsSystem/ecs/ecs_component.gd" id="base"]
[ext_resource type="Script" uid="uid://2viguy8kg1qx" path="res://9. EcsSystem/defs/ecs_entity_def.gd" id="def"]
[ext_resource type="Script" uid="uid://nslff4ri8k2p" path="res://9. EcsSystem/ai/ecs_skill_def.gd" id="s_skill_def"]
[ext_resource type="Script" uid="uid://c62j1k5pdptjl" path="res://9. EcsSystem/components/ecs_movement_component.gd" id="s_move"]
[ext_resource type="Script" uid="uid://occbigie8rhc" path="res://9. EcsSystem/components/ecs_body_component.gd" id="s_body"]
[ext_resource type="Script" uid="uid://dyejv2wq5luep" path="res://9. EcsSystem/components/ecs_action_component.gd" id="s_action"]
[ext_resource type="Script" uid="uid://dggyv3jo4spyn" path="res://9. EcsSystem/components/ecs_damage_component.gd" id="s_damage"]
[ext_resource type="Script" uid="uid://b0cqwu7rlda2j" path="res://9. EcsSystem/components/ecs_health_component.gd" id="s_health"]
[ext_resource type="Script" uid="uid://di5dlx4aqxnva" path="res://9. EcsSystem/components/ecs_skills_component.gd" id="s_skills"]
[ext_resource type="Script" uid="uid://crlgsdgqgc3wp" path="res://9. EcsSystem/components/ecs_sprite_component.gd" id="s_sprite"]
[ext_resource type="Script" path="res://11. EcsControl/components/ecs_player_component.gd" id="s_player"]
[ext_resource type="Resource" path="res://11. EcsControl/defs/skills/player_dash.tres" id="k_dash"]
[ext_resource type="Texture2D" uid="uid://bae16lxpt5p5x" path="res://Global/Asset/character.png" id="t_player"]

[sub_resource type="Resource" id="c_player"]
script = ExtResource("s_player")

[sub_resource type="Resource" id="c_move"]
script = ExtResource("s_move")
speed = 180.0

[sub_resource type="Resource" id="c_body"]
script = ExtResource("s_body")
radius = 20.0

[sub_resource type="Resource" id="c_action"]
script = ExtResource("s_action")
radius = 72.0

[sub_resource type="Resource" id="c_damage"]
script = ExtResource("s_damage")
damage = 20.0
interval = 0.45
crit_chance = 0.15

[sub_resource type="Resource" id="c_health"]
script = ExtResource("s_health")
power = 20.0

[sub_resource type="Resource" id="c_skills"]
script = ExtResource("s_skills")
swaps = Array[ExtResource("s_skill_def")]([ExtResource("k_dash")])

[sub_resource type="Resource" id="c_sprite"]
script = ExtResource("s_sprite")
texture = ExtResource("t_player")
scale_factor = 0.4
z_index = 2

[resource]
script = ExtResource("def")
id = &"player"
display_name = "Player"
components = Array[ExtResource("base")]([SubResource("c_player"), SubResource("c_move"), SubResource("c_body"), SubResource("c_action"), SubResource("c_damage"), SubResource("c_health"), SubResource("c_skills"), SubResource("c_sprite")])
