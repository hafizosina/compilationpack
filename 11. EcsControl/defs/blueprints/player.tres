[sub_resource type="Resource" id="c_player"]
script = ExtResource("s_player")

[sub_resource type="Resource" id="c_move"]
script = ExtResource("s_move")
speed = 180.0

[sub_resource type="Resource" id="c_body"]
script = ExtResource("s_body")
radius = 20.0

[sub_resource type="Resource" id="c_action"]
script = ExtResource("s_action")
radius = 72.0

[sub_resource type="Resource" id="c_damage"]
script = ExtResource("s_damage")
damage = 20.0
interval = 0.45
crit_chance = 0.15

[sub_resource type="Resource" id="c_health"]
script = ExtResource("s_health")
power = 20.0

[sub_resource type="Resource" id="c_skills"]
script = ExtResource("s_skills")
swaps = Array[ExtResource("s_skill_def")]([ExtResource("k_dash"), ExtResource("k_cleave"), ExtResource("k_whirlwind"), ExtResource("k_block"), ExtResource("k_fireball")])

[sub_resource type="Resource" id="c_weapon"]
script = ExtResource("s_weapon")
texture = ExtResource("t_sword")

[sub_resource type="Resource" id="c_stamina"]
script = ExtResource("s_stamina")

[sub_resource type="Resource" id="c_mana"]
script = ExtResource("s_mana")
regen = 8.0
regen_delay = 1.5

[sub_resource type="Resource" id="c_remains"]
script = ExtResource("s_remains")
leaves = Dictionary[StringName, StringName]({&"health": &"player_grave"})
darken = 0.5

[sub_resource type="Resource" id="c_sprite"]
script = ExtResource("s_sprite")
texture = ExtResource("t_player")
scale_factor = 0.4
z_index = 2

[resource]
script = ExtResource("def")
id = &"player"
display_name = "Player"
components = Array[ExtResource("base")]([SubResource("c_player"), SubResource("c_move"), SubResource("c_body"), SubResource("c_action"), SubResource("c_damage"), SubResource("c_health"), SubResource("c_skills"), SubResource("c_weapon"), SubResource("c_stamina"), SubResource("c_mana"), SubResource("c_remains"), SubResource("c_sprite")])
